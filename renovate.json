{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "nuget",
    "npm",
    "dockerfile",
    "github-actions"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "description": "Keep the .NET runtime/SDK images and Microsoft.Extensions packages in step",
      "groupName": ".NET",
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/**",
        "Microsoft.Extensions.**"
      ]
    },
    {
      "description": "The native libvips packages must all ship the same version",
      "groupName": "NetVips.Native",
      "matchPackageNames": [
        "NetVips.Native.**"
      ]
    },
    {
      "description": "Hangfire core packages are released together",
      "groupName": "Hangfire",
      "matchPackageNames": [
        "Hangfire.Core",
        "Hangfire.AspNetCore"
      ]
    },
    {
      "description": "Batch non-major GitHub Actions updates into one PR",
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    },
    {
      "description": "Wrangler, the Workers runtime and its Vitest pool must move together",
      "groupName": "Cloudflare Workers tooling",
      "matchPackageNames": [
        "wrangler",
        "@cloudflare/**",
        "vitest",
        "@vitest/**"
      ]
    }
  ]
}
